# This file contains example environment variables.
# For local development, you can copy this file to .env and fill in the values.

# --- PostgreSQL Configuration ---
POSTGRES_USER=atomai
POSTGRES_PASSWORD=atomai
POSTGRES_DB=atomai_db
DATABASE_URL=postgresql://atomai:atomai@postgres:5432/atomai_db

# --- Redis Configuration ---
REDIS_URL=redis://redis:6379

# --- MinIO/S3 Configuration ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=documents

# --- RabbitMQ Configuration ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Service-specific settings ---
# Add any other service-specific environment variables here.
# For example:
# PAYMENT_GATEWAY_API_KEY=your_api_key_here
