# -------------------------
# PostgreSQL Database
# -------------------------
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db

# -------------------------
# Backend (FastAPI)
# -------------------------
# This should match the DB credentials and service name in docker-compose
DATABASE_URL=postgresql+asyncpg://app_user:app_password@db:5432/app_db

# Generate a strong secret key, e.g., with: openssl rand -hex 32
SECRET_KEY=a_very_long_and_super_secret_key_that_should_be_changed
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# -------------------------
# Frontend (React/Vite)
# -------------------------
# For the existing Vite app, you might need to set this environment variable
# for local development (e.g., in .env.local or when running `npm run dev`).
# In production, Nginx will handle proxying, so this is not used by the container.
VITE_API_BASE_URL=http://localhost:8000/api/v1
